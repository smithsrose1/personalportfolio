



/* ========== Old Code for Learning purposes ========== */



html {
    scroll-behavior: smooth;
    scroll-padding-top: 80px; /* height of fixed header */
}

header {
    position: fixed; /* stays at top */
    top: 0;
    left: 0;
    width: 100%;
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: space-between;

    padding: 0 2rem;
    background: rgba(220, 122, 60, 0.6);
    backdrop-filter: blur(5px);

    z-index: 1000;
}
.logo img {
    height: 36px;
    width: auto;
}

nav ul {
    display: flex;
    list-style: none;
    gap: 1.5rem;
    margin: 75px;
    padding: 2;
}

.nav-item a {
    text-decoration: none;
    color: #ffffff;
    font-weight: 500;
    transition: color 0.3s;
}
.nav-item a:hover {
    color: #0f0e07;
    transition: color 0.3s ease-in-out;
}

body {
    font-family: sans-serif;
    text-align: center;
    padding-top: 50px;
    margin: 0%;
    width: 100vw;
    height: 100vh;
    background-color:#d8895e;
}

.middle-home-section {
    display: flex; /* Magic starts here */
    justify-content: center; /* Spacing between boxes */
    align-items: center;
    gap: 2rem;
    padding: 2rem;
    width: 100vw;
    max-width: 1200px;
    margin: 2% auto;
    flex-wrap: wrap; /* allows stacking */
    background-color:#f3d6c3;
}
.profile-container,
.intro-text {
    flex: 1 1 300px; /* grow, shrink, minimum width */
}

.profile-pic {
    width: min(500px, 90vw);
    height:auto;
    border-radius: 0%;
    object-fit: cover;
    display: block;
    margin: 0 auto;
}

.intro-text {
    font-size: clamp(1rem, 2.5vw, 1.1rem);
    color: #333;
    text-align: left;

}
.intro-text h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    color: #ec7133
}

.profile-container,
.intro-text {
    flex: 1 1 300px; /* grow, shrink, minimum width */
